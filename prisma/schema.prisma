// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id            String    @id @default(cuid())
  name          String
  position      String
  dateOfJoining DateTime
  mediaUrl      String
  mediaType     String    // "video" | "image"
  mediaPublicId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Service {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id String @id @default(cuid())

  title String
  slug String @unique

  shortDescription String? @db.Text

  overview String? @db.Text
  challenge String? @db.Text
  solution String? @db.Text
  results String? @db.Text

  featuredMediaUrl String?
  featuredMediaPublicId String?

  clientName String?
  projectUrl String?

  serviceId String?
  service Service? @relation(fields: [serviceId], references: [id])

  isFeatured Boolean @default(false)

  status ProjectStatus @default(PUBLISHED)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media ProjectMedia[]
  technologies ProjectTechnology[]

  @@index([slug])
  @@index([serviceId])
  @@index([status])
  @@index([createdAt])
}

model ProjectMedia {
  id String @id @default(cuid())

  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type MediaType

  url String
  publicId String

  fileName String?

  alt String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([type])
}

model ProjectTechnology {
  id String @id @default(cuid())

  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name String

  @@index([projectId])
}

model Testimonial {
  id        String    @id @default(cuid())
  content   String
  author    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Client {
  id           String    @id @default(cuid())
  name         String
  logoUrl      String
  logoPublicId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}
